# Configuración de la base de datos
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/astralis?retryWrites=true&w=majority

# Puerto del servidor
PORT=3000

# Entorno
NODE_ENV=development

# CORS Origins (separados por coma para producción)
CORS_ORIGINS=http://localhost:4200,http://localhost:4201

# JWT Configuration
JWT_SECRET=tu-secreto-jwt-muy-seguro
JWT_EXPIRES_IN=7d

# Email Configuration (SMTP2GO)
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USER=tu-usuario-smtp2go
SMTP_PASS=tu-api-key-smtp2go
EMAIL_FROM=Astralis <noreply@tudominio.com>

# Alternativa: Gmail (requiere App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-email@gmail.com
# SMTP_PASS=tu-app-password

# ==================== WOMPI ====================
# Sandbox (Pruebas)
# WOMPI_PUBLIC_KEY=pub_test_xxxx
# WOMPI_PRIVATE_KEY=prv_test_xxxx
# WOMPI_EVENTS_KEY=test_events_xxxx
# WOMPI_INTEGRITY_KEY=test_integrity_xxxx

# Production (Producción)
WOMPI_PUBLIC_KEY=pub_prod_xxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxx
WOMPI_EVENTS_KEY=prod_events_xxxx
WOMPI_INTEGRITY_KEY=prod_integrity_xxxx

# URL del webhook que configurarás en Wompi Dashboard
# https://tu-dominio.com/api/payments/webhooks/wompi

# ==================== EPAYCO (Futuro) ====================
# EPAYCO_PUBLIC_KEY=
# EPAYCO_PRIVATE_KEY=
# EPAYCO_P_KEY=
# EPAYCO_TEST=true

# ==================== FRONTEND URLS ====================
FRONTEND_URL=http://localhost:4200
PAYMENT_SUCCESS_URL=http://localhost:4200/checkout/success
PAYMENT_FAILURE_URL=http://localhost:4200/checkout/failure
